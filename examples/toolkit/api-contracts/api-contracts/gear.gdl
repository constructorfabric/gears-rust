# Gearbox product metadata for the api-contracts example gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (rest).
# Projected from #[toolkit::contract] in the SDK crate, per contract: its gear,
# version and kind. Which transports a contract is served over is projected
# from this gear's own `#[toolkit::provides(transports = [...])]`, so `provide`
# names the trait as a join key and declares only the generator inputs: base
# paths and the local factory.
#
# Note what that means here: the SDK has PaymentApiGrpc for v1, but this gear
# provides both versions over `[local, rest]` only -- the `grpc-client` feature
# is opt-in and used by a test that builds the gRPC client by hand. So there
# is no `grpc(...)` binding to declare: nothing could select it.

PAYMENT_SDK = cargo(
    crate_name = "cf-api-contracts-sdk",
    lib = "cf_api_contracts_sdk",
    path = "../api-contracts-sdk",
    features = ["rest-client"],
)

gear(
    maturity = "preview",
    name = "Payments (example provider)",
    description = "Provides PaymentApi v1 and v2 side by side, over local and REST transports.",
    category = "example",
    visibility = "public",

    # cf-api-contracts names its library target `cf_api_contracts` in
    # `[lib]`, NOT `api_contracts`. This is why `lib` is declared
    # rather than derived: deriving it would emit a link line that does not
    # compile.
    package = cargo(
        crate_name = "cf-api-contracts",
        lib = "cf_api_contracts",
        path = ".",
    ),

    provides = [
        provide(
            contract = "PaymentApi",
            rust = "api_contracts_sdk::PaymentApi",
            sdk = PAYMENT_SDK,
            local = "Self::build_local",
            rest = rest(base_path = "/api-contracts/v1"),
        ),
        # The second major of the same family. Its version comes from its own
        # #[toolkit::contract(version = "v2")], not from here.
        provide(
            contract = "PaymentApiV2",
            rust = "api_contracts_sdk::PaymentApiV2",
            sdk = PAYMENT_SDK,
            local = "Self::build_local_v2",
            rest = rest(base_path = "/api-contracts/v2", require_full_coverage = True),
        ),
    ],

    serves = [endpoint(name = "rest", via = "rest_host")],

    # `default` is Cargo's own and not a choice; the other two are.
    cargo_features = [feature("otel"), feature("grpc-client")],
)
