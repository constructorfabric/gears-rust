gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox description for the model-registry gear, which has no crate yet.
#
# `implementation = "design"`: listed in the catalogue with its documents, and
# not usable in a product (GBX0321). When the crate exists, describe it beside
# the crate instead -- `package = cargo(...)` and a `maturity`, no `id`
# (projected from #[toolkit::gear] then) -- and delete this file.

gear(
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/model-registry"),
    implementation = "design",
    id = "model-registry",
    name = "Model Registry",
    description = "Tenant-scoped catalog of AI model providers and models with inheritance, shadowing, and owner-tenant approval.",
    category = "gen-ai",

    # The SDK is published ahead of the gear; the catalogue records where it is.
    sdk = cargo(
        crate_name = "cf-gears-model-registry-sdk",
        lib = "model_registry_sdk",
        path = "model-registry-sdk",
    ),
)
