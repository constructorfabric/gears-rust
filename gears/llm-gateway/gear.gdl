# Gearbox description for the llm-gateway gear, which has no crate yet.
#
# `maturity = "design"`: listed in the catalogue with its documents, and not
# usable in a product (GBX0321). When the crate exists, describe it beside the
# crate instead -- `package = cargo(...)`, no `maturity`, no `id` (projected
# from #[toolkit::gear] then) -- and delete this file.

gear(
    maturity = "design",
    id = "llm-gateway",
    name = "LLM Gateway",
    description = "Unified LLM access with multimodal support, tool calling, and governance controls.",
    category = "gen-ai",

    # The SDK is published ahead of the gear; the catalogue records where it is.
    sdk = cargo(
        crate_name = "cf-gears-llm-gateway-sdk",
        lib = "llm_gateway_sdk",
        path = "llm-gateway-sdk",
    ),
)
