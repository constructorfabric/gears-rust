gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox description for the llm-gateway gear. The crate exists
# (`llm-gateway/`, `package = cargo(...)` below) and the gear is implemented in
# slices: see README.md "Status". Pending: the OAGW-backed media fetcher
# (slice 6b). The Credential Broker is keyless until `ModelInfoV1` exposes a
# secret reference (DESIGN § 4.9).
#
# Convention for a gear with a crate is to keep this file beside the crate and
# drop `id` (projected from #[toolkit::gear]); it stays here with an explicit
# `id` until the file is moved.

gear(
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/llm-gateway"),
    implementation = "in-progress",
    id = "llm-gateway",
    name = "LLM Gateway",
    description = "Unified LLM access with multimodal support, tool calling, and governance controls.",
    category = "gen-ai",

    maturity = "preview",

    package = cargo(
        crate_name = "cf-gears-llm-gateway",
        lib = "llm_gateway",
        path = "llm-gateway",
    ),

    sdk = cargo(
        crate_name = "cf-gears-llm-gateway-sdk",
        lib = "llm_gateway_sdk",
        path = "llm-gateway-sdk",
    ),
)
