// JSONC: // comments annotate field semantics for readers. Strip comments
// before feeding this file to a strict JSON / JSON-Schema consumer.
{
  "$id": "gts://gts.cf.core.events.event.v1~cf.core.tasks.wait_condition_set.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Task Engine lifecycle event type 'waitConditionSet'. Published when a wait condition is set on a task. Derived from the Event Broker base event type; routed to the task_events topic and partitioned by subject (the task ID) for per-task ordering.",
  "x-gts-traits": {
    "topic": "gts.cf.core.events.topic.v1~cf.core.tasks.task_events.v1",
    "partition_key": "/subject",
    "allowed_subject_types": [
      "gts.cf.core.tasks.task.v1~"
    ]
  },
  "type": "object",
  "allOf": [
    {
      "$ref": "gts://gts.cf.core.events.event.v1~"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "gts.cf.core.events.event.v1~cf.core.tasks.wait_condition_set.v1~",
          "$comment": "Pins the event-type identifier so an editor can validate a payload against this schema alone."
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "description": "The task.",
              "type": "string",
              "format": "uuid"
            },
            "resource_refs": {
              "description": "The task's resource references (PRD cpt-cf-task-engine-fr-resource-refs), carried on task-scoped events so consumers can route per resource without a read-back.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resource_type": {
                    "description": "GTS type identifier of the referenced resource.",
                    "type": "string",
                    "x-gts-type-ref": "gts.*"
                  },
                  "resource_id": {
                    "description": "Identifier of the referenced resource.",
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "required": [
                  "resource_type",
                  "resource_id"
                ]
              }
            },
            "wait_condition_id": {
              "description": "The wait condition.",
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "description": "Wait condition kind.",
              "type": "string",
              "enum": [
                "timer",
                "event",
                "input",
                "children"
              ]
            },
            "timeout_at": {
              "description": "When the wait condition times out, if configured.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "default": null
            },
            "parked": {
              "description": "`false` when the group was armed and the task keeps running (PRD §5.4 Arm before acting); `true` when the task was parked.",
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "task_id",
            "wait_condition_id",
            "kind"
          ]
        }
      }
    }
  ]
}
