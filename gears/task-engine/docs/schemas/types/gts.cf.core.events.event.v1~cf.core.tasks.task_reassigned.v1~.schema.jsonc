// JSONC: // comments annotate field semantics for readers. Strip comments
// before feeding this file to a strict JSON / JSON-Schema consumer.
{
  "$id": "gts://gts.cf.core.events.event.v1~cf.core.tasks.task_reassigned.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Task Engine lifecycle event type 'taskReassigned'. Published when a task is reassigned/handed off from one worker to another (PRD cpt-cf-task-engine-fr-reassignment). Derived from the Event Broker base event type; routed to the task_events topic and partitioned by subject (the task ID) for per-task ordering.",
  "x-gts-traits": {
    "topic": "gts.cf.core.events.topic.v1~cf.core.tasks.task_events.v1",
    "partition_key": "/subject",
    "allowed_subject_types": [
      "gts.cf.core.tasks.task.v1~"
    ]
  },
  "type": "object",
  "allOf": [
    {
      "$ref": "gts://gts.cf.core.events.event.v1~"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "gts.cf.core.events.event.v1~cf.core.tasks.task_reassigned.v1~",
          "$comment": "Pins the event-type identifier so an editor can validate a payload against this schema alone."
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "description": "The task.",
              "type": "string",
              "format": "uuid"
            },
            "resource_refs": {
              "description": "The task's resource references (PRD cpt-cf-task-engine-fr-resource-refs), carried on task-scoped events so consumers can route per resource without a read-back.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resource_type": {
                    "description": "GTS type identifier of the referenced resource.",
                    "type": "string",
                    "x-gts-type-ref": "gts.*"
                  },
                  "resource_id": {
                    "description": "Identifier of the referenced resource.",
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "required": [
                  "resource_type",
                  "resource_id"
                ]
              }
            },
            "previous_assignee": {
              "description": "Worker that previously held the lease (`worker_id`).",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "previous_assignee_subject": {
              "description": "Principal (`subject_id`) of the previous worker.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "default": null
            },
            "new_assignee": {
              "description": "New worker (`worker_id`), if assigned immediately.",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "new_assignee_subject": {
              "description": "Principal (`subject_id`) of the new worker.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256,
              "default": null
            },
            "reason": {
              "description": "Why the task was reassigned (e.g. lease_expiry, assignment_timeout, manual).",
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "reason"
          ]
        }
      }
    }
  ]
}
