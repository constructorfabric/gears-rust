{
  "$id": "gts://gts.cf.core.tasks.entry.v1~cf.core.tasks.entry_observation.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Pre-built task entry kind: an observation or check made during execution.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gts://gts.cf.core.tasks.entry.v1~"
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observation": {
              "description": "What was observed.",
              "type": "string",
              "maxLength": 2048
            },
            "subject": {
              "description": "Optional identifier of the thing observed.",
              "type": "string",
              "maxLength": 1024
            },
            "status": {
              "description": "Optional outcome of the observation/check (e.g. ok, degraded, failed).",
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "observation"
          ]
        }
      }
    }
  ]
}
