// Hand-authored GTS base type (NOT generated by gen_te_schemas.py).
// JSONC: // comments are terse reader hints; each field's authoritative
// meaning is its own "description". Strip comments before feeding this
// file to a strict JSON / JSON-Schema consumer.
{
  "$id": "gts://gts.cf.core.tasks.queue.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Queue base type. A queue is a named dispatch channel; every queue is registered as a GTS well-known instance of this type. The registration carries concurrency limits, a default priority, default timeout values, a default retry policy, optional queue-depth and worker-blacklist settings, optional default progress settings, and an optional dead-letter queue reference. A queue of kind 'dead_letter' is not a dispatch channel: it only holds parked dead_lettered tasks, is never claimable, and declares no dispatch settings. A queue and its dead-letter queue MUST resolve to the same task domain (PRD cpt-cf-task-engine-fr-dead-letter). Values declared here are defaults that operators MAY override in the Task Engine config file by GTS queue pattern (most specific pattern wins). Trait/field keys use snake_case per platform GTS convention.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Full GTS queue identifier (e.g. gts.cf.core.tasks.queue.v1~cf.core.tasks.default.v1). An instance, so it never ends in '~'.",
      "type": "string",
      "x-gts-instance-ref": "/$id"
    },
    "description": {
      "description": "Human-readable description of what the queue carries. ASCII only.",
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[\\x20-\\x7E]*$"
    },
    "kind": {  // dispatch | dead_letter
      "description": "'dispatch' (default): a normal queue that workers claim from. 'dead_letter': holds parked dead_lettered tasks only (PRD cpt-cf-task-engine-fr-dead-letter); it is never dispatched, a claim naming it is rejected 400 invalid_argument, and it MUST NOT declare any dispatch setting (concurrency, priority, timeouts, retry, depth, blacklist, progress, fairness, dead_letter_queue).",
      "type": "string",
      "enum": [
        "dispatch",
        "dead_letter"
      ],
      "default": "dispatch"
    },
    "global_concurrency_limit": {
      "description": "Maximum number of simultaneously executing (claimed + running) tasks from this queue across all tenants. 0 means unlimited (PRD cpt-cf-task-engine-fr-queue-concurrency).",
      "type": "integer",
      "minimum": 0
    },
    "per_tenant_concurrency_limit": {
      "description": "Maximum number of simultaneously executing (claimed + running) tasks from this queue per tenant. 0 means unlimited.",
      "type": "integer",
      "minimum": 0
    },
    "default_priority": {
      "description": "Default task priority for tasks enqueued to this queue when the creator supplies none. Lower numeric value = higher priority.",
      "type": "integer"
    },
    "timeouts": {  // all values are seconds; null/absent = no timeout of that kind
      "description": "Default timeout values applied to tasks on this queue when the task itself declares none. All values are in seconds; null/absent means no timeout of that kind.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queue_timeout_secs": {  // cap on time spent 'queued'; terminal on expiry
          "description": "Maximum time a task may wait in 'queued' before it is force-completed as timed out (terminal).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "assignment_timeout_secs": {  // cap on 'claimed'->started; liveness requeue on expiry
          "description": "Maximum time a claimed task may remain 'claimed' before it starts (assignment_deadline); on expiry it is a liveness failure and the task is requeued with backoff against max_liveness_requeues (not max_retries).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "execution_timeout_secs": {  // cap on running time per attempt; terminal, never retried
          "description": "Maximum running time per attempt (execution_deadline, re-armed on each start so time spent waiting is never counted). Terminal, task-attributed, never retried.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "heartbeat_timeout_secs": {  // lease duration; workers heartbeat every 1/3 of it
          "description": "Lease duration: the maximum interval between worker heartbeats before the lease expires; falls back to default_lease_duration_secs when null. Workers MUST heartbeat at the heartbeat_interval_secs returned on claim (one third of this value, rounded down, minimum 1) so a single delayed heartbeat does not expire the lease. An expired lease is a liveness failure: the task is requeued with backoff against max_liveness_requeues (not max_retries).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "lifetime_timeout_secs": {  // absolute create->terminal budget; overrides retry/lease
          "description": "Absolute wall-clock budget from creation to terminal state, surviving requeues. On expiry the task is force-completed as timed out (overrides retry/lease handling).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        }
      }
    },
    "retry_policy": {
      "description": "Default retry policy for tasks on this queue when the task declares none.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retries": {  // explicit retryable failures; liveness requeues do not count
          "description": "Maximum number of retries after explicit retryable failures reported by a worker. Liveness requeues (lease expiry, assignment timeout) do not consume this budget; see max_liveness_requeues.",
          "type": "integer",
          "minimum": 0
        },
        "max_liveness_requeues": {  // lease-expiry / assignment-timeout requeues; 0 = unlimited
          "description": "Maximum number of liveness requeues (lease expiry or assignment timeout) before the task is routed terminally with a timedOut result. Counted separately from max_retries so losing the worker never burns the failure-retry budget. Backoff uses this policy's strategy and intervals, applied to the liveness-requeue count. 0 means unlimited (bounded only by the lifetime timeout, if any).",
          "type": "integer",
          "minimum": 0,
          "default": 20
        },
        "strategy": {  // fixed | linear | exponential
          "description": "Backoff strategy used to compute run_after for a retry.",
          "type": "string",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ]
        },
        "base_interval_secs": {
          "description": "Base backoff interval in seconds.",
          "type": "integer",
          "minimum": 0
        },
        "max_interval_secs": {
          "description": "Maximum backoff interval in seconds (caps exponential/linear growth).",
          "type": "integer",
          "minimum": 0
        },
        "jitter_factor": {  // 0.0-1.0, de-syncs retries
          "description": "Fractional jitter (0.0-1.0) applied to each computed backoff to de-synchronize retries.",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "non_retryable_codes": {
          "description": "Error codes that are always terminal regardless of the worker's retryable flag.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "max_retries",
        "strategy",
        "base_interval_secs",
        "max_interval_secs"
      ]
    },
    "queue_max_queue_depth": {
      "description": "Maximum 'queued' tasks in this queue across all tenants. 0 means unlimited. Falls back to the configured default when omitted; overridable in config.",
      "type": "integer",
      "minimum": 0
    },
    "blacklist_failure_threshold": {
      "description": "Consecutive worker failures on this queue that trigger a worker blacklisting (PRD cpt-cf-task-engine-fr-worker-blacklist). Falls back to the config default when omitted.",
      "type": "integer",
      "minimum": 1
    },
    "blacklist_duration_minutes": {
      "description": "How long a blacklisted worker is excluded from claiming on this queue. Falls back to the config default when omitted.",
      "type": "integer",
      "minimum": 1
    },
    "progress_events": {
      "description": "Default progress event mode for tasks on this queue (PRD cpt-cf-task-engine-fr-progress-events): 'none', 'milestones', or 'all'. Lower precedence than task-type traits and config overrides.",
      "type": "string",
      "enum": [
        "none",
        "milestones",
        "all"
      ]
    },
    "progress_flush_interval_secs": {
      "description": "Default progress flush interval (seconds) for tasks on this queue. Effective value is clamped to progress_min_flush_interval_secs.",
      "type": "integer",
      "minimum": 1
    },
    "tenant_fairness": {  // round_robin | fifo
      "description": "How tasks of the same priority from different tenants are ordered (PRD cpt-cf-task-engine-fr-tenant-fairness). 'round_robin' (default): tenants take turns, each tenant's own tasks stay FIFO. 'fifo': strict FIFO across tenants. Priority always comes first. Overridable in config by queue pattern.",
      "type": "string",
      "enum": [
        "round_robin",
        "fifo"
      ],
      "default": "round_robin"
    },
    "dead_letter_queue": {
      "description": "Optional GTS identifier of the queue that tasks are dead-lettered into when they exhaust retries or exceed their lifetime. MUST reference a queue of kind 'dead_letter' (checked by the engine when it resolves the queue) and MUST resolve to the same task domain as this queue. Absent means failing tasks transition to 'failed' instead of being dead-lettered.",
      "type": [
        "string",
        "null"
      ],
      "x-gts-instance-ref": "gts.cf.core.tasks.queue.v1~",
      "default": null
    }
  },
  "required": [
    "id"
  ],
  "if": {
    "properties": {
      "kind": {
        "const": "dead_letter"
      }
    },
    "required": [
      "kind"
    ]
  },
  "then": {
    "$comment": "Dead-letter queues carry no dispatch settings.",
    "properties": {
      "global_concurrency_limit": false,
      "per_tenant_concurrency_limit": false,
      "default_priority": false,
      "timeouts": false,
      "retry_policy": false,
      "queue_max_queue_depth": false,
      "blacklist_failure_threshold": false,
      "blacklist_duration_minutes": false,
      "progress_events": false,
      "progress_flush_interval_secs": false,
      "tenant_fairness": false,
      "dead_letter_queue": false
    }
  },
  "else": {
    "required": [
      "global_concurrency_limit",
      "per_tenant_concurrency_limit",
      "default_priority",
      "timeouts",
      "retry_policy"
    ]
  }
}
