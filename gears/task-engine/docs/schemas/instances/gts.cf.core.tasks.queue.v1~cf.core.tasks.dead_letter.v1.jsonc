// JSONC: // comments annotate field semantics for readers. Strip comments
// before feeding this file to a strict JSON / JSON-Schema consumer.
{
  "id": "gts.cf.core.tasks.queue.v1~cf.core.tasks.dead_letter.v1",
  "description": "Terminal dead-letter queue. Tasks that exhaust retries or exceed their lifetime on a queue with this queue configured as its dead_letter_queue are parked here for inspection and manual re-enqueue (PRD cpt-cf-task-engine-fr-dead-letter). It is not dispatched from by normal workers and declares no dead-letter queue of its own.",
  "global_concurrency_limit": 0,  // max concurrent (claimed+running) tasks across all tenants; 0 = unlimited
  "per_tenant_concurrency_limit": 0,  // max concurrent (claimed+running) tasks per tenant; 0 = unlimited
  "default_priority": 100,  // default priority when the creator supplies none; lower number = higher priority
  "timeouts": {
    "queue_timeout_secs": null,  // seconds a task may sit in 'queued' before it is force-timed-out (terminal); null = no limit
    "assignment_timeout_secs": null,  // seconds a claimed task may stay 'claimed' before it starts; on expiry it is requeued against max_liveness_requeues; null = no limit
    "execution_timeout_secs": null,  // running seconds per attempt (re-armed on each start); terminal, never retried; null = no limit
    "heartbeat_timeout_secs": null,  // lease duration; workers heartbeat every heartbeat_interval_secs (= 1/3 of this, returned on claim); expiry requeues against max_liveness_requeues; null = default_lease_duration_secs
    "lifetime_timeout_secs": null  // absolute seconds from creation to terminal, surviving requeues; on expiry force-timed-out; null = no limit
  },
  "retry_policy": {
    "max_retries": 0,  // retries after explicit retryable failures (liveness requeues not counted); 0 = no retries
    "max_liveness_requeues": 0,  // lease-expiry / assignment-timeout requeues allowed; separate from max_retries; 0 = unlimited (bounded only by lifetime)
    "strategy": "fixed",  // backoff curve for run_after: fixed | linear | exponential
    "base_interval_secs": 0,  // base backoff interval in seconds
    "max_interval_secs": 0,  // cap on backoff growth in seconds
    "jitter_factor": 0,  // fractional jitter 0.0-1.0 applied to each backoff to de-sync retries
    "non_retryable_codes": []  // error codes always terminal regardless of the worker's retryable flag
  },
  "queue_max_queue_depth": 0,  // max 'queued' tasks across all tenants; 0 = unlimited
  "dead_letter_queue": null  // queue tasks are dead-lettered into on retry-exhaustion/lifetime; null = transition to 'failed' instead
}
