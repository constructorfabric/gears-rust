gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the OIDC AuthN plugin.
#
# Fills the same extension point as static-authn-plugin, so the two are
# alternatives: a product picks one per deployment profile.
#
# Note this crate states its vendor default with `#[serde(default =
# "default_vendor")]` and a free function rather than an `impl Default` block.
# Both spellings exist in the tree and the projector reads both -- reading only
# the first would report "no default" here, and a missing default is what the
# vendor-match check keys on.

gear(
    deps = ["authn-resolver", "types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/authn-resolver/plugins/oidc-authn-plugin"),
    maturity = "preview",
    name = "OIDC AuthN Plugin",
    description = "Validates bearer tokens against an OIDC issuer.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-oidc-authn-plugin",
        lib = "oidc_authn_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.authn_resolver.plugin.v1~",

    # The selection keys, and the blocks a product description must be able to
    # state: `jwt` (issuers, audience), `s2s_oauth` (the discovery URL) and
    # `http_client` (an IdP whose certificate a private CA issued needs
    # `custom_ca_certificate_paths`). The other nested blocks (caches, circuit
    # breaker, retry) keep their defaults; see docs/config-example.yaml beside
    # this gear.
    config_schema = config(exposes = ["vendor", "priority", "jwt", "s2s_oauth", "http_client"]),

    # Empty rather than absent: `e2e-diagnostics` is a test switch, so there is
    # nothing a product should be offered here.
    cargo_features = [],
)
