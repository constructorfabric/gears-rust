gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the static AuthN plugin.
#
# Projected from #[toolkit::gear]: id, runtime_caps (system).
# Declared below: which extension point this gear implements, by the spec its host
# declares. The `impl AuthNResolverPluginClient` in this crate is checked
# against the declaration, not read as it.
# Projected from this crate's own config: the vendor and priority it registers
# itself under (`constructorfabric` / 100), which is the join key the host's
# `vendor` selector matches against.

TR_SDK = cargo(crate_name = "cf-gears-types-registry-sdk", lib = "types_registry_sdk", path = "../../../types-registry/types-registry-sdk", features = ["rest-client"])

gear(
    deps = [],
    # The instance is published over the consumed platform contract in `post_init`.
    consumes = [consume(contract = "PlatformTypesRegistryApi", rust = "types_registry_sdk::PlatformTypesRegistryApi", sdk = TR_SDK)],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/authn-resolver/plugins/static-authn-plugin"),
    maturity = "preview",
    name = "Static AuthN Plugin",
    description = "Accepts configured tokens and returns a fixed identity. For dev and test.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-static-authn-plugin",
        lib = "static_authn_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.authn_resolver.plugin.v1~",

    # `mode` is an enum, and its variants are read from AuthNMode rather than
    # listed here -- adding one needs no change to this file or to Gearbox.
    # Strict token and S2S mappings may be supplied by prepared products.
    config_schema = config(exposes = ["vendor", "priority", "mode", "tokens", "s2s_credentials"]),
)
