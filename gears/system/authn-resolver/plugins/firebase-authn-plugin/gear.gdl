gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the Firebase AuthN plugin.
#
# Fills the same extension point as static-authn-plugin and oidc-authn-plugin,
# so they are alternatives: a product picks one per deployment profile.

gear(
    deps = ["types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/authn-resolver/plugins/firebase-authn-plugin"),
    maturity = "preview",
    name = "Firebase AuthN Plugin",
    description = "Verifies Firebase ID tokens and maps configured UIDs to tenant identities.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-firebase-authn-plugin",
        lib = "firebase_authn_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.authn_resolver.plugin.v1~",

    # Tenants and scopes come only from `identities`, never from the token.
    config_schema = config(exposes = ["vendor", "priority", "project_id", "subject_namespace", "identities"]),
)
