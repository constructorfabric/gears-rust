# Gearbox product metadata for the Static License Plugin.
#
# Fills license-resolver's extension point, declared by `implements`; this plugin's
# vendor and priority are read from source.

gear(
    maturity = "preview",
    name = "Static License Plugin",
    description = "License grants from static configuration rules, for development and testing.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-static-license-plugin",
        lib = "static_license_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.license_resolver.plugin.v1~",

    # `grants` is a list of rules; no control renders it, so it stays in the
    # configuration file.
    config_schema = config(exposes = ["vendor", "priority"]),
)
