gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for Single-Tenant Resolver Plugin.
#
# One of three alternatives filling tenant-resolver's extension point. The
# point is declared by `implements`; this plugin's vendor and priority are read
# from source.

gear(
    deps = ["types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/tenant-resolver/plugins/single-tenant-tr-plugin"),
    maturity = "preview",
    name = "Single-Tenant Resolver Plugin",
    description = "Resolves every request to one fixed tenant.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-single-tenant-tr-plugin",
        lib = "single_tenant_tr_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.tenant_resolver.plugin.v1~",

    # priority defaults to 1000 so static-tr-plugin wins when both are enabled.
    config_schema = config(exposes = ["vendor", "priority"]),
)
