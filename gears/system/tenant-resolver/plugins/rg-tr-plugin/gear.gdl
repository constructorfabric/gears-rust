gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for Resource-Group Tenant Resolver Plugin.
#
# One of three alternatives filling tenant-resolver's extension point. The
# point is declared by `implements`; this plugin's vendor and priority are read
# from source.

gear(
    deps = ["resource-group", "types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/tenant-resolver/plugins/rg-tr-plugin"),
    maturity = "preview",
    name = "Resource-Group Tenant Resolver Plugin",
    description = "Derives tenant identity from the resource-group hierarchy. It needs a seeded resource-group, so a fresh deployment uses the static tenant resolver plugin.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-rg-tr-plugin",
        lib = "rg_tr_plugin",
        path = ".",
    ),

    # The point this plugin implements, by the GTS spec its host declares. The
    # declaration is the role; the `impl` in this crate is only checked against
    # it. No `sdk`: the host's SDK is the host's.
    implements = "cf.core.tenant_resolver.plugin.v1~",

    # It resolves the root tenant from resource-group, and nothing seeds
    # resource-group at startup: a product composed with this plugin alone
    # resolves, then fails at init (#5328). The reference configurations use
    # static-tr-plugin with the root in `tenants`, which boots.
    config_schema = config(exposes = ["vendor", "priority"]),
)
