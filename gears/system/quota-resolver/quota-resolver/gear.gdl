gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the Quota Resolver.
#
# Projected from #[toolkit::gear]: id, runtime_caps (rest), colocated_deps
# (types-registry). One `vendor` selector chooses which registered plugin
# answers; `principal_subject_types` maps principal types to quota subject types.

gear(
    deps = ["types-registry"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/quota-resolver/quota-resolver"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Quota Resolver",
    description = "Gateway for quota operations: maps principals to quota subjects and delegates to a quota backend plugin.",
    category = "core-platform-integration",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-quota-resolver",
        lib = "quota_resolver",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-quota-resolver-sdk",
        lib = "quota_resolver_sdk",
        path = "../quota-resolver-sdk",
    ),

    # The point plugins fill, keyed by the GTS spec their instances register
    # under and this gear selects by. Declared, and checked against the sdk: the
    # spec must be a `PluginV1` type it declares, the trait a `pub trait` in it.
    extension_points = [
        extension_point("cf.core.quota_resolver.plugin.v1~", trait = "QuotaResolverPluginClient"),
    ],

    # The selector and the principal mapping.
    config_schema = config(exposes = ["vendor", "principal_subject_types"]),
)
