gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the settings-service gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (db, rest, stateful),
# colocated_deps (types-registry, credstore), lifecycle; the authz-resolver
# edge from #[toolkit::consumes].


AUTHZ_SDK = cargo(crate_name = "cf-gears-authz-resolver-sdk", lib = "authz_resolver_sdk", path = "../../system/authz-resolver/authz-resolver-sdk", features = ["rest-client"])

gear(
    deps = ["credstore", "types-registry"],
    # The authorization resolver is consumed, not linked: local when co-located,
    # REST with the platform token otherwise.
    consumes = [consume(contract = "AuthZResolverApi", rust = "authz_resolver_sdk::AuthZResolverApi", sdk = AUTHZ_SDK)],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/settings-service/settings-service"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Settings Service",
    description = "Typed configuration and feature flags with tenant-scoped inheritance and validate-then-set writes.",
    category = "serverless",
    visibility = "internal",

    # Both crates name their library target explicitly, after the package
    # name with underscores -- not `settings_service`.
    package = cargo(
        crate_name = "cf-gears-settings-service",
        lib = "cf_gears_settings_service",
        path = ".",
    ),
    sdk = cargo(
        crate_name = "cf-gears-settings-service-sdk",
        lib = "cf_gears_settings_service_sdk",
        path = "../settings-service-sdk",
    ),

    config_schema = config(),
)
