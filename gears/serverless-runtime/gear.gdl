gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox description for the serverless-runtime gear, which has no crate yet.
#
# `implementation = "design"`: listed in the catalogue with its documents, and
# not usable in a product (GBX0321). When the crate exists, describe it beside
# the crate instead -- `package = cargo(...)` and a `maturity`, no `id`
# (projected from #[toolkit::gear] then) -- and delete this file.

gear(
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/serverless-runtime"),
    implementation = "design",
    id = "serverless-runtime",
    name = "Serverless Runtime",
    description = "Pluggable serverless runtime for Starlark, serverlessworkflow, and Python function execution.",
    category = "serverless",
)
