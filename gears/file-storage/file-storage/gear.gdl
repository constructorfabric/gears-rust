gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for File Storage.
#
# Projected from #[toolkit::gear]: id, runtime_caps (db, rest, stateful),
# colocated_deps (authz-resolver).

gear(
    deps = ["authz-resolver"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/file-storage/file-storage"),
    maturity = "preview",
    implementation = "in-progress",
    name = "File Storage",
    description = "Abstract file storage API with pluggable backends for media and generated content.",
    category = "core-functionality",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-file-storage",
        lib = "file_storage",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-file-storage-sdk",
        lib = "file_storage_sdk",
        path = "../file-storage-sdk",
    ),

    # The operator's knobs. Not offered: `signing_key_pkcs8` and
    # `finalize_internal_secret`, which are secrets -- a form that saved one
    # would write it into the description; `s3_backends`, a list of nested
    # backend records; and `default_backend_id`, which only means something
    # against that list. `require_signing_key`, which guards the private key, is
    # offered, since it is policy rather than a credential.
    config_schema = config(exposes = [
        "storage_root",
        "sidecar_base_url",
        "default_url_ttl_secs",
        "max_url_ttl_secs",
        "default_page_size",
        "max_page_size",
        "idempotency_ttl_secs",
        "enable_in_memory_backend",
        "require_signing_key",
    ]),

    # `default = []` is the only feature and enables nothing.
    cargo_features = [],
)
