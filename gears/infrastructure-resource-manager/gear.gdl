# Gearbox description for the infrastructure-resource-manager gear, which has no crate yet.
#
# `maturity = "design"`: listed in the catalogue with its documents, and not
# usable in a product (GBX0321). When the crate exists, describe it beside the
# crate instead -- `package = cargo(...)`, no `maturity`, no `id` (projected
# from #[toolkit::gear] then) -- and delete this file.

gear(
    maturity = "design",
    id = "infrastructure-resource-manager",
    name = "Infrastructure Resource Manager",
    description = "Unified resource orchestration with declarative deployments, diff engine, and adapter framework.",
    category = "oss",
)
