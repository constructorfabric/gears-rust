{
  "$id": "gts://gts.cf.core.graph.node.v1~cf.core.graph.owned_node.v1~cf.construct.person.skill.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A person's skills: skills, languages, research areas, publications, awards and research metrics. One node is one fact. Its payload holds one property, which names the fact, and the origin of the fact. It also holds record, the record the fact came from, exactly when the fact came from a record.",
  "type": "object",
  "allOf": [
    {
      "$ref": "gts://gts.cf.core.graph.node.v1~cf.core.graph.owned_node.v1~"
    },
    {
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin"
          ],
          "properties": {
            "origin": {
              "$ref": "gts://gts.cf.core.graph.attribute.v1~cf.core.graph.provenance.v1~"
            },
            "record": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "connector",
                "provenance",
                "version"
              ],
              "description": "The record a fact came from, when it came from one: the connector that sent it and the record's identity.",
              "properties": {
                "connector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S",
                  "description": "The connector that sent the record."
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S",
                  "description": "The record's identity within the connector."
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S",
                  "description": "The record's version."
                }
              }
            },
            "activity_by_year": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "year"
              ],
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": 1800,
                  "description": "Calendar year.",
                  "maximum": 2100
                },
                "works": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "citations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                }
              }
            },
            "awards": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "year": {
                  "type": "integer",
                  "minimum": 1800,
                  "description": "Calendar year.",
                  "maximum": 2100
                },
                "issuer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                }
              }
            },
            "career_stage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "first_publication_year": {
              "type": "integer",
              "minimum": 1800,
              "description": "Calendar year.",
              "maximum": 2100
            },
            "h_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "i10_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "languages": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
              "description": "ISO 639 language code, optionally with an ISO 3166 region: en, de, en-GB."
            },
            "latest_publication_year": {
              "type": "integer",
              "minimum": 1800,
              "description": "Calendar year.",
              "maximum": 2100
            },
            "mean_citedness_2y": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "primary_research_area": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "publications": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "year": {
                  "type": "integer",
                  "minimum": 1800,
                  "description": "Calendar year.",
                  "maximum": 2100
                },
                "venue": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "doi": {
                  "type": "string",
                  "pattern": "^10\\.\\d{4,9}/\\S+$",
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "maxLength": 2048
                },
                "openalex_id": {
                  "type": "string",
                  "pattern": "^W\\d+$",
                  "maxLength": 100
                }
              }
            },
            "research_areas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "skills": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "beginner",
                    "intermediate",
                    "advanced",
                    "expert"
                  ]
                },
                "years": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "total_citations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "total_publications": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "oneOf": [
            {
              "required": [
                "record"
              ],
              "minProperties": 3,
              "maxProperties": 3
            },
            {
              "not": {
                "required": [
                  "record"
                ]
              },
              "minProperties": 2,
              "maxProperties": 2
            }
          ]
        }
      },
      "required": [
        "payload"
      ]
    }
  ]
}
