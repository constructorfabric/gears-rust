    {
      "id": "commit-authority-before-dispatch",
      "steps": [
        {
          "op": "open",
          "expect": "denied",
          "verified": false,
          "version": 7,
          "roster": [
            "k1",
            "k2"
          ]
        },
        {
          "op": "create",
          "expect": "not_authorized",
          "key": "k1",
          "version": 7,
          "payload": "receipt-a"
        }
      ],
      "expected": {
        "pending": 0,
        "active": 0,
        "reconcile": []
      }
    },
    {
