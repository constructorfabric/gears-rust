          "rule": "current_version",
          "event_version": 7,
          "current_version": 7,
          "version_read": "ok",
          "current_read": "ok",
          "state": "in_fulfillment"
        },
        {
          "op": "deliver",
          "expect": "duplicate",
          "event_id": "e1",
          "broker_sequence": 1,
          "known_event": true,
          "known_state": true,
          "rule": "current_version",
          "event_version": 7,
          "current_version": 7,
          "version_read": "ok",
          "current_read": "ok",
          "state": "in_fulfillment"
        }
      ],
      "expected": {
        "complete": [
          "e1"
        ],
        "pending": [],
        "effects": [
          "e1"
        ],
        "reads": 2
      }
    },
