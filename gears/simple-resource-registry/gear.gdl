# Gearbox description for the simple-resource-registry gear, which has no crate yet.
#
# `maturity = "design"`: listed in the catalogue with its documents, and not
# usable in a product (GBX0321). When the crate exists, describe it beside the
# crate instead -- `package = cargo(...)`, no `maturity`, no `id` (projected
# from #[toolkit::gear] then) -- and delete this file.

gear(
    maturity = "design",
    id = "simple-resource-registry",
    name = "Durable Objects",
    description = "Generic typed-resource CRUD storage with GTS validation and pluggable backends.",
    category = "serverless",
)
